# =============================================================================
# Variáveis de ambiente — Vanguarda Builder (frontend Vite/React) na Vercel
# -----------------------------------------------------------------------------
# Cole estes valores no painel da Vercel:
#   Project → Settings → Environment Variables (Production + Preview)
#
# IMPORTANTE: use os nomes EXATOS que o app lê. Abra
#   src/integrations/supabase/client.ts
# e confira se ele usa VITE_SUPABASE_PUBLISHABLE_KEY (Lovable novo) ou
# VITE_SUPABASE_ANON_KEY (padrão antigo). Só o par que o código lê é obrigatório.
#
# Onde achar os valores do SEU novo projeto Supabase:
#   Supabase → Project Settings → API
#     - Project URL         -> VITE_SUPABASE_URL
#     - Project API keys     -> anon/public  -> VITE_SUPABASE_ANON_KEY
#     - (ou) Publishable key -> VITE_SUPABASE_PUBLISHABLE_KEY
#   O <project-ref> é o subdomínio da URL (https://<project-ref>.supabase.co).
# =============================================================================

# --- Supabase (projeto PRÓPRIO — substitui o Supabase gerenciado do Lovable) --
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Use UMA das duas linhas abaixo, conforme o client.ts do app:
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# VITE_SUPABASE_ANON_KEY=<anon-public-key>

# =============================================================================
# ATENÇÃO — chaves que NÃO vão para o frontend/Vercel:
#   - service_role key
#   - senha do banco (DATABASE_URL)
#   - segredos de Edge Functions (OPENAI_API_KEY, HUBSPOT_*, RD_STATION_*, etc.)
# Esses ficam APENAS no Supabase (Edge Functions → Secrets) e nunca em VITE_*,
# pois toda variável VITE_ é embutida no bundle público do navegador.
# =============================================================================
